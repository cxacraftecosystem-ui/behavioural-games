{
  "name": "@shriii/kiosk-electron",
  "version": "0.1.0",
  "private": true,
  "description": "SHRIII kiosk runtime: hardened Electron main process (kiosk window, app:// protocol, CSP, watchdog), encrypted SQLite outbox and uploader, thermal printer, signed update rings",
  "author": "SHRIII",
  "homepage": "https://shriii.local",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:renderer": "pnpm --filter @shriii/kiosk build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && node scripts/smoke.mjs",
    "electron:install": "node node_modules/electron/install.js",
    "start": "node scripts/build.mjs && electron .",
    "pack": "node scripts/build.mjs --with-renderer && electron-builder --dir --config electron-builder.yml",
    "dist:linux": "node scripts/build.mjs --with-renderer && electron-builder --linux snap AppImage --config electron-builder.yml",
    "dist:win": "node scripts/build.mjs --with-renderer && electron-builder --win dir --config electron-builder.yml",
    "lint": "biome check ."
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@shriii/contracts": "workspace:*",
    "@shriii/escpos-printer": "workspace:*",
    "@shriii/kiosk-game": "workspace:*",
    "@shriii/outbox-sqlite": "workspace:*",
    "@shriii/session-crypto": "workspace:*",
    "@types/node": "^24.19.2",
    "electron": "44.9.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
