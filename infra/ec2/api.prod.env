# Production settings for the API, worker and one-shot jobs on EC2. NON-SECRET values only.
# Secrets (database URLs, keys, LOCAL_JWT_SECRET) come from SSM /shriii/prod/* via render-env.sh into
# /etc/shriii/api.env, which compose loads after this file.
ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true

# Staff auth: no OIDC provider yet, so staff accounts live in governance.staff_users (POST /api/v1/auth/login).
# Dev login is refused whenever ENV=prod. Switch to AUTH_MODE=oidc + OIDC_JWKS_URL when Cognito/OIDC exists.
AUTH_MODE=local
JWT_ISSUER=shriii-prod
JWT_AUDIENCE=shriii-api
LOCAL_JWT_TTL_MINUTES=480

# CORS: the Vercel web app. The Vercel project "behavioural-games" (scope cxacraftecosystem-8028) did not exist
# when this was written, so production and preview URLs are matched by pattern. Replace with the exact
# production origin(s) (and the custom domain) once known; see docs/deploy/aws-ec2.md.
API_CORS_ORIGINS=https://behavioural-games.vercel.app
API_CORS_ORIGIN_REGEX='https://behavioural-games[a-z0-9-]*\.vercel\.app'
PUBLIC_BASE_URL=https://behavioural-games.vercel.app

RELEASE_PACK_KEY_ID=prod-release-key-1
PID_PEPPER_VERSION=1
DATA_DIR=/var/lib/shriii
WORKER_POLL_INTERVAL_S=2.0
OTEL_ENABLED=false
